{
	email {$GEODUBBER_ACME_EMAIL}
}

{$GEODUBBER_DOMAIN} {
	encode zstd gzip
	reverse_proxy geodubber:10000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-X-Powered-By
	}
	request_body {
		max_size 9GB
	}
}
